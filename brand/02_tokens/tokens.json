{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Primestone Media · design tokens · source de vérité unique. Format DTCG 2025.10. Ne pas éditer les fichiers de brand/02_tokens/build : ils sont générés par tools/build-tokens.mjs.",
  "$extensions": {
    "media.primestone": {
      "version": "0.1.0",
      "statut": "provisoire",
      "direction": "Signal + Kiosque",
      "postscript": {
        "display": "Anton-Regular",
        "editorial": "InstrumentSerif-Italic",
        "editorial-roman": "InstrumentSerif-Regular",
        "text": "Archivo-Regular",
        "text-medium": "Archivo-Medium",
        "text-bold": "Archivo-Bold",
        "text-condensed": "ArchivoCondensed-Bold",
        "mono": "JetBrainsMono-Regular",
        "mono-bold": "JetBrainsMono-Bold"
      },
      "note": "Noms PostScript utilisés par les scripts Adobe (voir brand/03_fonts/fonts.json)."
    }
  },
  "color": {
    "$type": "color",
    "brand": {
      "yellow": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1,
            0.898,
            0
          ],
          "hex": "#FFE500"
        },
        "$description": "Jaune Primestone de référence. Valeur proposée lors de l'audit, à confirmer. Seul jaune autorisé."
      },
      "black": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.067,
            0.067,
            0.067
          ],
          "hex": "#111111"
        },
        "$description": "Noir d'encre : textes, sceau, cadres, liserés."
      },
      "black-pure": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "hex": "#000000"
        },
        "$description": "Fond du logo principal et des écrans vidéo."
      },
      "white": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1,
            1,
            1
          ],
          "hex": "#FFFFFF"
        }
      }
    },
    "editorial": {
      "paper": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.925,
            0.922,
            0.902
          ],
          "hex": "#ECEBE6"
        },
        "$description": "Fond papier Kiosque."
      },
      "news-red": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1,
            0.231,
            0.188
          ],
          "hex": "#FF3B30"
        },
        "$description": "Réservé exclusivement aux actualités."
      },
      "warm-1": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.961,
            0.851,
            0.659
          ],
          "hex": "#F5D9A8"
        },
        "$description": "Données / chronologies, 3e couleur."
      },
      "warm-2": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.91,
            0.753,
            0.541
          ],
          "hex": "#E8C08A"
        },
        "$description": "Données / chronologies, 4e couleur."
      },
      "warm-3": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.851,
            0.843,
            0.812
          ],
          "hex": "#D9D7CF"
        },
        "$description": "Données / chronologies, 5e couleur."
      }
    },
    "cinematic": {
      "$description": "Direction sombre et cinématographique : usage secondaire (dossiers cosmiques, événements).",
      "night": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.027,
            0.031,
            0.043
          ],
          "hex": "#07080B"
        }
      },
      "night-blue": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.114,
            0.153,
            0.259
          ],
          "hex": "#1D2742"
        }
      },
      "silver": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.788,
            0.8,
            0.839
          ],
          "hex": "#C9CCD6"
        }
      }
    },
    "data": {
      "1": {
        "$value": "{color.brand.black}"
      },
      "2": {
        "$value": "{color.brand.yellow}"
      },
      "3": {
        "$value": "{color.editorial.warm-1}"
      },
      "4": {
        "$value": "{color.editorial.warm-2}"
      },
      "5": {
        "$value": "{color.editorial.warm-3}"
      }
    },
    "legacy": {
      "$description": "Jaunes relevés dans les fichiers d'origine (archive, ne pas utiliser).",
      "yellow-icon": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.878,
            0.871,
            0.024
          ],
          "hex": "#E0DE06"
        }
      },
      "yellow-wordmark": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1,
            0.961,
            0.012
          ],
          "hex": "#FFF503"
        }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": [
          "Anton",
          "Impact",
          "Arial Narrow",
          "sans-serif"
        ],
        "$description": "Titres Signal (miniatures, accroches, titres vidéo)."
      },
      "editorial": {
        "$value": [
          "Instrument Serif",
          "Times New Roman",
          "serif"
        ],
        "$description": "Voix Kiosque, de préférence en italique."
      },
      "text": {
        "$value": [
          "Archivo",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ],
        "$description": "Textes, chapôs, interface."
      },
      "text-condensed": {
        "$value": [
          "Archivo Condensed",
          "Archivo",
          "Arial Narrow",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "Consolas",
          "monospace"
        ],
        "$description": "Rubriques, numéros, crédits, données."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "bold": {
        "$value": 700
      },
      "extrabold": {
        "$value": 800
      }
    }
  },
  "motif": {
    "incision-angle": {
      "$type": "number",
      "$value": 8,
      "$description": "Angle de l'incision en degrés, inclinaison vers la droite (haut décalé à droite). Relevé sur le logotype."
    },
    "seal-radius-ratio": {
      "$type": "number",
      "$value": 0.22,
      "$description": "Rayon des coins du sceau P, en fraction de son côté."
    },
    "seal-glyph-box": {
      "$type": "number",
      "$value": 0.56,
      "$description": "Largeur du P dans le sceau, en fraction du côté."
    },
    "ink-outline-ratio": {
      "$type": "number",
      "$value": 0.0035,
      "$description": "Épaisseur du liseré d'encre autour des personnages, en fraction de la largeur du support."
    },
    "benday-cell-ratio": {
      "$type": "number",
      "$value": 0.013,
      "$description": "Pas de la trame Ben-Day, en fraction de la largeur."
    },
    "benday-opacity": {
      "$type": "number",
      "$value": 0.08
    }
  },
  "format": {
    "$type": "dimension",
    "youtube-thumbnail": {
      "width": {
        "$value": {
          "value": 1280,
          "unit": "px"
        }
      },
      "height": {
        "$value": {
          "value": 720,
          "unit": "px"
        }
      }
    },
    "carousel": {
      "width": {
        "$value": {
          "value": 1080,
          "unit": "px"
        }
      },
      "height": {
        "$value": {
          "value": 1350,
          "unit": "px"
        }
      }
    },
    "story": {
      "width": {
        "$value": {
          "value": 1080,
          "unit": "px"
        }
      },
      "height": {
        "$value": {
          "value": 1920,
          "unit": "px"
        }
      }
    },
    "video-hd": {
      "width": {
        "$value": {
          "value": 1920,
          "unit": "px"
        }
      },
      "height": {
        "$value": {
          "value": 1080,
          "unit": "px"
        }
      }
    },
    "video-uhd": {
      "width": {
        "$value": {
          "value": 3840,
          "unit": "px"
        }
      },
      "height": {
        "$value": {
          "value": 2160,
          "unit": "px"
        }
      }
    }
  },
  "layout": {
    "$type": "dimension",
    "thumbnail": {
      "$description": "Grille miniature YouTube 1280×720.",
      "margin": {
        "$value": {
          "value": 58,
          "unit": "px"
        },
        "$description": "4,5 % de la largeur, quatre côtés."
      },
      "seal-size": {
        "$value": {
          "value": 102,
          "unit": "px"
        },
        "$description": "8 % de la largeur. Bas gauche, jamais déplacé."
      },
      "dead-zone-width": {
        "$value": {
          "value": 192,
          "unit": "px"
        },
        "$description": "Coin bas droit masqué par la durée YouTube."
      },
      "dead-zone-height": {
        "$value": {
          "value": 80,
          "unit": "px"
        }
      },
      "title-cap-min": {
        "$value": {
          "value": 86,
          "unit": "px"
        },
        "$description": "Hauteur de capitale minimale du titre (12 % de la hauteur)."
      }
    },
    "carousel": {
      "margin": {
        "$value": {
          "value": 65,
          "unit": "px"
        },
        "$description": "6 % de la largeur."
      },
      "masthead-rule": {
        "$value": {
          "value": 5,
          "unit": "px"
        }
      },
      "panel-border": {
        "$value": {
          "value": 6,
          "unit": "px"
        }
      }
    },
    "video": {
      "safe-title": {
        "$value": {
          "value": 96,
          "unit": "px"
        },
        "$description": "Marge titre en 1920×1080 (5 %)."
      },
      "bug-size": {
        "$value": {
          "value": 96,
          "unit": "px"
        },
        "$description": "Filigrane P en 1920×1080."
      }
    }
  },
  "typography": {
    "$type": "typography",
    "thumbnail-title": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": {
          "value": 150,
          "unit": "px"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        },
        "lineHeight": 0.86
      },
      "$description": "Capitales, alignées à gauche, 3 mots max."
    },
    "thumbnail-rubric": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": {
          "value": 27,
          "unit": "px"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": 3.8,
          "unit": "px"
        },
        "lineHeight": 1
      }
    },
    "carousel-title": {
      "$value": {
        "fontFamily": "{font.family.editorial}",
        "fontSize": {
          "value": 140,
          "unit": "px"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": -2.8,
          "unit": "px"
        },
        "lineHeight": 0.92
      },
      "$description": "Italique."
    },
    "carousel-body": {
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontSize": {
          "value": 39,
          "unit": "px"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        },
        "lineHeight": 1.45
      }
    },
    "carousel-label": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": {
          "value": 28,
          "unit": "px"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": 3.4,
          "unit": "px"
        },
        "lineHeight": 1.2
      }
    },
    "lower-third-name": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": {
          "value": 84,
          "unit": "px"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        },
        "lineHeight": 1
      }
    },
    "lower-third-role": {
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontSize": {
          "value": 38,
          "unit": "px"
        },
        "fontWeight": 500,
        "letterSpacing": {
          "value": 0.4,
          "unit": "px"
        },
        "lineHeight": 1
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": {
          "value": 320,
          "unit": "ms"
        },
        "$description": "8 images à 25 i/s : entrée d'un bandeau."
      },
      "base": {
        "$value": {
          "value": 480,
          "unit": "ms"
        },
        "$description": "12 images : transition coupe incisée."
      },
      "slow": {
        "$value": {
          "value": 600,
          "unit": "ms"
        },
        "$description": "15 images : maximum pour un mouvement d'habillage."
      },
      "logo-reveal": {
        "$value": {
          "value": 3200,
          "unit": "ms"
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "primestone": {
        "$value": [
          0.7,
          0,
          0.2,
          1
        ],
        "$description": "Courbe unique : accélération forte, arrivée douce."
      }
    },
    "fps": {
      "$type": "number",
      "$value": 25
    }
  }
}
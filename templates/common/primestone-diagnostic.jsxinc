// Primestone · fonctions communes des scripts de diagnostic (ExtendScript ES3, Photoshop / Illustrator / After Effects).
// Aucune modification de document : lecture seule + écriture d'un rapport texte sur le Bureau.
function PS_Report(appLabel) {
  this.app = appLabel; this.lines = []; this.ok = 0; this.ko = 0;
}
PS_Report.prototype.add = function (status, label, detail) {
  if (status === true) this.ok++; else if (status === false) this.ko++;
  this.lines.push((status === true ? "[OK]   " : status === false ? "[MANQUE] " : "[INFO] ") + label + (detail ? " : " + detail : ""));
};
PS_Report.prototype.save = function () {
  var f = new File(Folder.desktop + "/Primestone_diagnostic_" + this.app.replace(/\s+/g, "-") + ".txt");
  f.encoding = "UTF-8"; f.lineFeed = "Windows"; f.open("w");
  f.writeln("PRIMESTONE · DIAGNOSTIC " + this.app.toUpperCase());
  f.writeln("Tokens v" + PRIMESTONE.version + " (" + PRIMESTONE.statut + ") · " + new Date().toString());
  f.writeln("--------------------------------------------------------------");
  for (var i = 0; i < this.lines.length; i++) f.writeln(this.lines[i]);
  f.writeln("--------------------------------------------------------------");
  f.writeln(this.ok + " contrôle(s) OK, " + this.ko + " manquant(s).");
  f.close();
  return f;
};
// Teste chaque police PostScript du système Primestone avec une fonction fournie par l'application.
function PS_checkFonts(report, finder) {
  var seen = {};
  for (var k in PRIMESTONE.fonts) {
    var ps = PRIMESTONE.fonts[k];
    if (seen[ps]) continue; seen[ps] = true;
    var res;
    try { res = finder(ps); } catch (e) { res = false; }
    if (res === null) report.add(null, "Police " + ps, "non vérifiable dans cette version");
    else report.add(!!res, "Police " + ps, res ? "installée" : "à installer depuis brand/03_fonts");
  }
}
